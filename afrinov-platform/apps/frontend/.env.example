# Set to "true" to run the frontend without the backend/database (uses mock data).
# Leave unset or "false" for normal development against the real API.
# A production build (npm run build) refuses to run if this or
# VITE_DEMO_AUTH_ENABLED is "true"; use npm run build:frontend-only for a demo bundle.
VITE_FRONTEND_ONLY=false

# Set to "true" to enable the demo authentication flow (accepts a single
# hardcoded credential pair for review/demo purposes). Leave unset or "false"
# in production so the app always uses the real backend login.
VITE_DEMO_AUTH_ENABLED=false

# Demo credentials used only when VITE_DEMO_AUTH_ENABLED=true.
# Leave unset to disable demo login entirely.
VITE_DEMO_AUTH_EMAIL=
VITE_DEMO_AUTH_PASSWORD=

# Purchase orders and goods receipts. Off unless "true". Keep in step with
# PROCUREMENT_ENABLED on the backend, which registers the matching API routes.
VITE_PROCUREMENT_ENABLED=false
