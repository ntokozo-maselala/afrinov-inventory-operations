# Copy to .env for local development. Never commit .env.
#
# JWT_SECRET must be a strong random value. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# The placeholder below is intentionally NOT a usable secret: loadConfig()
# rejects it in production so a copied example file can never end up signing
# real tokens. If you previously deployed using the old example value, rotate
# JWT_SECRET — that value is public in version control.
DATABASE_URL="postgresql://afrinov:afrinov@localhost:5432/afrinov?schema=public"
JWT_SECRET="REPLACE_WITH_RANDOM_SECRET_generate_one_above"
NODE_ENV="development"
PORT="4000"
HOST="0.0.0.0"
LOG_LEVEL="info"

# Comma-separated allow-list of browser origins permitted to call the API.
# Unset in development falls back to the local Vite dev server origins.
# Required in production; when unset, production CORS is disabled.
# CORS_ORIGIN="http://localhost:5173"

# Escape hatch: set to "true" to reflect any request origin with credentials.
# Intended only for throwaway demo environments. Refused in production.
# CORS_ALLOW_ANY="true"

# Rate limits (requests per minute per client IP). Defaults: auth 5, global 1000.
# RATE_LIMIT_AUTH=5
# RATE_LIMIT_GLOBAL=1000

# Proxies allowed to report the client address (X-Forwarded-For): a hop count
# (usually 1 behind one load balancer), a comma-separated list of addresses or
# CIDR ranges, or "true". Unset when the API is reached directly.
# TRUST_PROXY=1

# Longest one SQL statement may run, in milliseconds (default 30000; 0 = off).
# DB_STATEMENT_TIMEOUT_MS=30000

# Purchase orders and goods receipts. On unless "false"; when off, their API
# routes are not registered. Keep in step with VITE_PROCUREMENT_ENABLED in the
# frontend.
# PROCUREMENT_ENABLED="false"

# API docs (Swagger UI) at /api/docs. On by default except in production.
# API_DOCS_ENABLED="false"

# Password for the admin@afrinov.local account the seed creates; it must be
# changed at the first sign-in. Needed only until that account exists (required
# then in production). In development an unset value makes the seed generate a
# random password that it does not print.
# Demo data is loaded only by `npm run db:seed:demo` (or SEED_DEMO_DATA="true"),
# and never when NODE_ENV is production.
# SEED_ADMIN_PASSWORD="choose-a-local-password"

# Admin email used by the integration tests and the diagnostic scripts. The
# seed always creates admin@afrinov.local, so only change this to point those
# tools at a different existing account.
# SEED_ADMIN_EMAIL="admin@afrinov.local"

# ISO currency code returned with the inventory report's values. Default: ZAR.
# REPORT_CURRENCY="ZAR"
