// Afrinov Platform — Prisma schema
// Source of truth for the data model, derived from the docs in
// afrinov-docs/docs/03-domain/entity-catalog.md, aggregate-model.md,
// domain-model.md, state-machines.md, and 02-business-analysis/functional-requirements.md.
// ADR-002: inventory_transactions is the ledger; inventory_balances is a derived
// materialized view that is never written by application code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity & Access ────────────────────────────────────────────────────

enum RoleName {
  ADMIN
  STORE_CONTROLLER
  PROCUREMENT
  // View only since orders are signed by the four roles below.
  APPROVER
  TECHNICIAN
  VIEWER
  PROCUREMENT_MANAGER
  DIRECTOR
  CEO
  WORKSHOP_MANAGER
  SALES
}

// The signatures an order can need, in the order they are signed.
enum ApprovalStep {
  MANAGER
  DIRECTOR
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  name               String
  passwordHash       String    @map("password_hash")
  active             Boolean   @default(true)
  // Set when an Admin gives a temporary password (ADR-036): until the person
  // chooses their own, they can do nothing else.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  // A sign-in that began before this is refused, so changing a password ends
  // every other session (ADR-036).
  passwordChangedAt  DateTime? @map("password_changed_at")
  // No longer read: who signs an order goes by role and the order's value. Kept
  // so older records keep their history.
  approvalLimit      Decimal?  @map("approval_limit") @db.Decimal(18, 2)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  roles                   UserRole[]
  settingsUpdated         Setting[]                @relation("SettingUpdatedBy")
  purchaseOrders          PurchaseOrder[]          @relation("PO_CreatedBy")
  approvedPurchaseOrders  PurchaseOrder[]          @relation("PO_ApprovedBy")
  shippedPurchaseOrders   PurchaseOrder[]          @relation("PO_ShippedBy")
  deliveredPurchaseOrders PurchaseOrder[]          @relation("PO_DeliveredBy")
  cancelledPurchaseOrders PurchaseOrder[]          @relation("PO_CancelledBy")
  closedPurchaseOrders    PurchaseOrder[]          @relation("PO_ClosedBy")
  purchaseOrderSignatures PurchaseOrderSignature[] @relation("PO_SignedBy")
  goodsReceipts           GoodsReceipt[]           @relation("GR_ReceivedBy")
  inventoryTransactions   InventoryTransaction[]
  managedProjects         Project[]                @relation("ProjectManager")
  rfqs                    Rfq[]                    @relation("RFQ_CreatedBy")
  sentRfqs                Rfq[]                    @relation("RFQ_SentBy")
  awardedRfqs             Rfq[]                    @relation("RFQ_AwardedBy")
  cancelledRfqs           Rfq[]                    @relation("RFQ_CancelledBy")
  recommendedRfqs         Rfq[]                    @relation("RFQ_RecommendedBy")
  rfqQuoteFiles           RfqQuoteFile[]           @relation("RFQ_QuoteFileUploadedBy")
  salesRfqs               SalesRfq[]               @relation("SalesRfq_CreatedBy")
  submittedSalesRfqs      SalesRfq[]               @relation("SalesRfq_SubmittedBy")
  approvedSalesRfqs       SalesRfq[]               @relation("SalesRfq_ApprovedBy")
  returnedSalesRfqs       SalesRfq[]               @relation("SalesRfq_ReturnedBy")
  cancelledSalesRfqs      SalesRfq[]               @relation("SalesRfq_CancelledBy")
  idempotencyKeys         IdempotencyKey[]
  toolLoanExtensions      ToolLoanExtension[]
  consumableOutcomes      ConsumableOutcome[]
  materialStatusChanges   MaterialStatusChange[]
  requestedAdjustments    AdjustmentRequest[]      @relation("AdjustmentRequestedBy")
  decidedAdjustments      AdjustmentRequest[]      @relation("AdjustmentDecidedBy")
  createdProjectSchedules ProjectSchedule[]        @relation("ProjectScheduleCreatedBy")
  assignedProjectSteps    ProjectStep[]            @relation("ProjectStepAssignee")
  capturedReceipts        ReceiptConfirmation[]    @relation("ReceiptCapturedBy")
  costChanges             MaterialCostChange[]
  signIns                 SignInEvent[]
  // The recipient this person is at the counter, when they are one (system audit F5).
  recipient               Recipient?

  @@map("users")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Role {
  id          String           @id @default(uuid())
  name        RoleName         @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  // Format: "action:resource", e.g. "create:purchase_order", "issue:inventory"
  code        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─── Master Data ──────────────────────────────────────────────────────────

enum MaterialCategory {
  FASTENERS_SLUGS_INSULATION
  TOOLING_PPE_ELECTRICAL
  PROJECT_MATERIAL
  CONSUMABLES
  TOOLS
}

// How an item is counted. A COUNTED unit (each, pair, box) takes whole
// numbers only; a MEASURED one (m, kg, l) takes up to the 4 decimal places the
// quantity columns hold.
enum UnitKind {
  COUNTED
  MEASURED
}

// The units of measure items can use, keyed by the code items store. Every
// item points at one, so "EA", "pcs" and "each" can't be three different units.
// needsReview marks a unit carried over from before this list that matched none
// of its codes: kept as MEASURED so nothing stopped working, and listed until
// its items are moved to a listed unit.
model UnitOfMeasure {
  code        String   @id
  label       String
  kind        UnitKind
  needsReview Boolean  @default(false) @map("needs_review")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")

  materials     Material[]

  @@map("units_of_measure")
}

model Material {
  id            String           @id @default(uuid())
  sku           String           @unique
  name          String
  description   String?
  category      MaterialCategory
  unitOfMeasure String           @map("unit_of_measure")
  requiredStock Decimal          @default(0) @map("required_stock") @db.Decimal(18, 4)
  unitCost      Decimal?         @map("unit_cost") @db.Decimal(18, 4)
  // A tool kept as one unit (a drill, a harness): its maker's serial number.
  // Only tools have one; null for everything else.
  serialNumber  String?          @unique @map("serial_number")
  // Projects material (category PROJECT_MATERIAL): the one project it is
  // bought for. Stores material has none. Null on a Projects item that has
  // not been assigned its project yet.
  projectNumber String?          @map("project_number")
  // A consumable whose fate after issue is recorded (a disc, a blade, a bit):
  // each issue of it is later closed off as used up or broken, and whatever is
  // neither returned nor closed off is still out with the person. Never a tool.
  trackUse      Boolean          @default(false) @map("track_use")
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  poLines               PurchaseOrderLine[]
  goodsReceiptLines     GoodsReceiptLine[]
  inventoryTransactions InventoryTransaction[]
  inventoryBalances     InventoryBalance[]
  stockCountLines       StockCountLine[]
  rfqLines              RfqLine[]
  adjustmentRequests    AdjustmentRequest[]
  statusChanges         MaterialStatusChange[]
  costChanges           MaterialCostChange[]
  project               Project?               @relation(fields: [projectNumber], references: [projectNumber])
  unit                  UnitOfMeasure          @relation(fields: [unitOfMeasure], references: [code])

  @@index([category])
  @@index([active])
  @@index([projectNumber])
  @@map("materials")
}

enum LocationType {
  RACK
  STOREROOM
  SHOP_FLOOR_AREA
  CONTAINER
  OFF_SITE
}

model Location {
  id            String       @id @default(uuid())
  name          String       @unique
  // Short, human-friendly identifier (e.g. "WH-A1"). Unique across the
  // catalogue. Falls back to null for legacy rows that pre-date this field;
  // application code treats null code as the existing `name`.
  code          String?      @unique
  type          LocationType
  active        Boolean      @default(true)
  // The room or area this location stands in: rack "D-1" in "Main Storeroom".
  // One level only — a location with a parent is never a parent itself, and a
  // rack is never a parent. Stock stays on the location itself (the rack).
  parentId      String?      @map("parent_id")
  // Extended master-data fields (added with the Location Management feature).
  address       String?
  description   String?
  contactPerson String?      @map("contact_person")
  contactPhone  String?      @map("contact_phone")
  contactEmail  String?      @map("contact_email")
  notes         String?
  createdById   String?      @map("created_by_id")
  updatedById   String?      @map("updated_by_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  goodsReceiptLines     GoodsReceiptLine[]
  inventoryTransactions InventoryTransaction[]
  inventoryBalances     InventoryBalance[]
  adjustmentRequests    AdjustmentRequest[]
  parent                Location?              @relation("LocationParent", fields: [parentId], references: [id], onDelete: Restrict)
  children              Location[]             @relation("LocationParent")

  @@index([type])
  @@index([active])
  @@index([parentId])
  @@map("locations")
}

model Supplier {
  id           String   @id @default(uuid())
  name         String
  contactName  String?  @map("contact_name")
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  notes        String?
  // From the vendor list in the AFRI-0000_x purchase order template.
  // vendorCode is the template's "V001"; stored upper-case.
  vendorCode   String?  @unique @map("vendor_code")
  address      String?
  currency     String   @default("ZAR")
  paymentTerms String?  @map("payment_terms")
  website      String?
  services     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  rfqSuppliers   RfqSupplier[]
  recommendedOn  Rfq[]              @relation("RFQ_RecommendedSupplier")
  salesMaterials SalesRfqMaterial[]

  // Case-insensitive name uniqueness is enforced at the database
  // level via a citext unique index (migration
  // 20260101000002_supplier_name_uniqueness). The plain index
  // below remains for case-sensitive lookups; the app-layer
  // check in SupplierService.create produces the friendly 409.
  @@index([name])
  @@map("suppliers")
}

model Project {
  projectNumber String    @id @map("project_number")
  // Extended project master fields (added with the Projects feature).
  // projectNumber remains the canonical identifier so existing transactions,
  // movement references, and migration data keep working unchanged.
  name          String?
  code          String?   @unique
  status        String    @default("PLANNING")
  managerId     String?   @map("manager_id")
  client        String?
  startDate     DateTime? @map("start_date") @db.Date
  endDate       DateTime? @map("end_date") @db.Date
  notes         String?
  active        Boolean   @default(true)
  updatedAt     DateTime  @updatedAt @map("updated_at")
  description   String?
  createdAt     DateTime  @default(now()) @map("created_at")

  manager               User?                  @relation("ProjectManager", fields: [managerId], references: [id])
  inventoryTransactions InventoryTransaction[] @relation("UsedFor")
  // Stock held for the project (see InventoryTransaction.heldForProject).
  stockHeld             InventoryTransaction[] @relation("HeldFor")
  purchaseOrders        PurchaseOrder[]
  materials             Material[]
  rfqs                  Rfq[]
  salesRfqs             SalesRfq[]
  schedules             ProjectSchedule[]

  @@index([status])
  @@index([active])
  @@map("projects")
}

// ── Job tracking (ADR-032, Project Tracking Roadmap) ─────────────────────
// A project's work as one or more schedules of steps, replacing the
// 03 Projects Tracking Schedule workbook and ClickUp. Most projects have one
// schedule; a split job has one per part, a recurring job one per month.
enum ProjectScheduleStatus {
  // Steps and their baseline dates are being planned.
  PLANNING
  // Started: the baseline is locked, and steps carry a forecast and progress.
  ACTIVE
  // Every step is done.
  DONE
  CANCELLED
}

model ProjectSchedule {
  id            String                @id @default(uuid())
  projectNumber String                @map("project_number")
  name          String
  status        ProjectScheduleStatus @default(PLANNING)
  // The date promised to the client, if one was. Optional.
  dueDate       DateTime?             @map("due_date") @db.Date
  // A joint job is tracked on one of its projects; these are the others it
  // covers, so their orders count towards its Procurement step.
  alsoCovers    String[]              @default([]) @map("also_covers")
  createdById   String                @map("created_by_id")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  project   Project       @relation(fields: [projectNumber], references: [projectNumber], onDelete: Restrict, onUpdate: Restrict)
  createdBy User          @relation("ProjectScheduleCreatedBy", fields: [createdById], references: [id])
  steps     ProjectStep[]

  @@index([projectNumber])
  @@index([status])
  @@map("project_schedules")
}

model ProjectStep {
  id            String    @id @default(uuid())
  scheduleId    String    @map("schedule_id")
  // Order within the schedule, from 1.
  position      Int
  name          String
  // The plan, locked when the schedule starts; changed only by a re-plan.
  baselineStart DateTime? @map("baseline_start") @db.Date
  baselineEnd   DateTime? @map("baseline_end") @db.Date
  // When the step is now expected, while it is under way.
  forecastStart DateTime? @map("forecast_start") @db.Date
  forecastEnd   DateTime? @map("forecast_end") @db.Date
  // Set once it happened; the actual end only with progress at 100.
  actualStart   DateTime? @map("actual_start") @db.Date
  actualEnd     DateTime? @map("actual_end") @db.Date
  // 0 to 100.
  progress      Int       @default(0)
  assigneeId    String?   @map("assignee_id")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  schedule ProjectSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  assignee User?           @relation("ProjectStepAssignee", fields: [assigneeId], references: [id])

  @@index([scheduleId, position])
  @@index([assigneeId])
  @@map("project_steps")
}

// Who stock is issued to. The workbook's "Issued To" list mixed workers with
// machines, client sites and contractors, so each entry carries its type.
enum RecipientType {
  WORKER
  MACHINE
  SITE
  CONTRACTOR
}

// People and places stock is issued to. Most are not users who log in.
// Names are unique ignoring case (index in migration 20260101000005).
// Deactivate instead of deleting, so issue history keeps its recipient.
model Recipient {
  id             String        @id @default(uuid())
  name           String
  type           RecipientType
  notes          String?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  // Counter PIN (ADR-034): workers and contractors confirm what they take with
  // it. Only the bcrypt hash is kept, and it never leaves the server. Wrong
  // tries count up to inventory.receiptPinTries, then the PIN locks until a
  // store controller unlocks it.
  pinHash        String?       @map("pin_hash")
  pinSetAt       DateTime?     @map("pin_set_at")
  pinFailedTries Int           @default(0) @map("pin_failed_tries")
  pinLockedAt    DateTime?     @map("pin_locked_at")
  // The user account of this person, when they have one, so a slip they issue
  // to themselves is seen (system audit F5). One account per recipient.
  userId         String?       @unique @map("user_id")
  user           User?         @relation(fields: [userId], references: [id])

  inventoryTransactions InventoryTransaction[]
  adjustmentRequests    AdjustmentRequest[]
  receiptsSigned        ReceiptConfirmation[]

  @@index([type])
  @@index([active])
  @@map("recipients")
}

// ─── Proof of receipt (ADR-034) ───────────────────────────────────────────
// The person collecting an issue or a tool loan confirms the slip. The slip
// posts first, as it always has; a confirmation sits beside it and never
// moves stock.

enum ReceiptSlipKind {
  ISSUE
  LOAN
}

// NONE: not confirmed, with the reason. A real confirmation may follow it.
enum ReceiptMethod {
  PIN
  SIGNATURE
  PAPER
  NONE
}

enum ReceiptSkipReason {
  LEFT
  CANNOT
  NO_SCREEN
  DISPUTED
  OTHER
}

// Add-only. A slip (an issueId) has at most one row that is not NONE, which a
// partial unique index enforces (migration 20260101000053); NONE rows may
// come before it.
model ReceiptConfirmation {
  id               String             @id @default(uuid())
  slipId           String             @map("slip_id")
  slipKind         ReceiptSlipKind    @map("slip_kind")
  method           ReceiptMethod
  // Who confirmed: the recipient, or for a machine or site, the person who collected.
  signerId         String?            @map("signer_id")
  reason           ReceiptSkipReason?
  note             String?
  // A hash of the slip's lines when it was confirmed, so a later reversal shows.
  linesFingerprint String?            @map("lines_fingerprint")
  capturedById     String             @map("captured_by_id")
  confirmedAt      DateTime           @default(now()) @map("confirmed_at")
  // Set when the image is removed after inventory.receiptImageKeepMonths.
  imageRemovedAt   DateTime?          @map("image_removed_at")

  signer     Recipient?    @relation(fields: [signerId], references: [id], onDelete: Restrict)
  capturedBy User          @relation("ReceiptCapturedBy", fields: [capturedById], references: [id])
  image      ReceiptImage?

  @@index([slipId])
  @@index([confirmedAt])
  @@map("receipt_confirmations")
}

// The signature or the photo of a signed slip, apart from its record so it
// can be removed when its time is up without losing the fact it was signed.
model ReceiptImage {
  confirmationId String @id @map("confirmation_id")
  contentType    String @map("content_type")
  size           Int
  data           Bytes

  confirmation ReceiptConfirmation @relation(fields: [confirmationId], references: [id], onDelete: Cascade)

  @@map("receipt_images")
}

// ─── Procurement ──────────────────────────────────────────────────────────

// DRAFT → PENDING_APPROVAL → APPROVED → PARTIALLY_RECEIVED → RECEIVED → CLOSED,
// or CANCELLED before anything is received. Local suppliers deliver with an
// invoice, so there is no shipping stage (migration 20260101000004).
enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  number               String              @unique
  // As the template's "Rev 00": raised each time the order is changed after approval.
  revision             Int                 @default(0)
  supplierId           String              @map("supplier_id")
  status               PurchaseOrderStatus @default(DRAFT)
  notes                String?
  // Copied from the supplier and the VAT setting when the order is raised, so
  // later changes to either don't rewrite it. vatRate is a percentage (15.00).
  currency             String              @default("ZAR")
  vatRate              Decimal             @default(15) @map("vat_rate") @db.Decimal(5, 2)
  // Rand per unit of the order's currency, locked when the order is submitted
  // so a later change of rate can't change who has to sign. Null on rand orders.
  exchangeRate         Decimal?            @map("exchange_rate") @db.Decimal(18, 6)
  // ── Order details from the template's Inputs sheet ───────────────────────
  // Optional: general store stock is bought without a project.
  projectNumber        String?             @map("project_number")
  // The supplier's contact and address, as on the template's Inputs sheet:
  // copied from the supplier when the order is raised; editable on the order.
  supplierContactName  String?             @map("supplier_contact_name")
  supplierContactPhone String?             @map("supplier_contact_phone")
  supplierContactEmail String?             @map("supplier_contact_email")
  supplierAddress      String?             @map("supplier_address")
  // Copied from the supplier when the order is raised; editable on the order.
  paymentTerms         String?             @map("payment_terms")
  paymentMilestone     String?             @map("payment_milestone")
  settlementDiscount   Decimal             @default(0) @map("settlement_discount") @db.Decimal(5, 2)
  shippingTerms        String?             @map("shipping_terms")
  penaltiesApply       Boolean             @default(false) @map("penalties_apply")
  // The small print (terms, documentation, invoicing, code of conduct) as it
  // was when the order was approved, so a later change to the settings does
  // not change what the supplier accepted. Null until approved.
  printedTerms         Json?               @map("printed_terms")
  // DELIVERY: the supplier delivers to the address below. COLLECTION: Afrinov collects.
  deliveryMethod       String              @default("DELIVERY") @map("delivery_method")
  deliveryTo           String?             @map("delivery_to")
  deliveryAddress      String?             @map("delivery_address")
  deliveryCountry      String?             @map("delivery_country")
  deliveryContactName  String?             @map("delivery_contact_name")
  deliveryContactPhone String?             @map("delivery_contact_phone")
  // Who at Afrinov the supplier deals with; typed, so it need not be a user.
  afrinovContact       String?             @map("afrinov_contact")
  createdById          String              @map("created_by_id")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  // ── Lifecycle audit fields (added with the PO workflow enhancement) ───────
  // All populated transactionally by the procurement service. Never overwritten
  // once set; only updated when the corresponding transition occurs.
  expectedDeliveryDate DateTime?           @map("expected_delivery_date") @db.Date
  approvedAt           DateTime?           @map("approved_at")
  approvedById         String?             @map("approved_by_id")
  shippedAt            DateTime?           @map("shipped_at")
  shippedById          String?             @map("shipped_by_id")
  trackingNumber       String?             @map("tracking_number")
  carrier              String?
  shipmentNotes        String?             @map("shipment_notes")
  // The shipped_* columns above are no longer written (there is no shipping
  // stage); they are kept so older records keep their history.
  // delivered_* records when the order became fully RECEIVED.
  deliveredAt          DateTime?           @map("delivered_at")
  deliveredById        String?             @map("delivered_by_id")
  deliveryNotes        String?             @map("delivery_notes")
  cancelledAt          DateTime?           @map("cancelled_at")
  cancelledById        String?             @map("cancelled_by_id")
  cancellationReason   String?             @map("cancellation_reason")
  closedAt             DateTime?           @map("closed_at")
  closedById           String?             @map("closed_by_id")
  closeReason          String?             @map("close_reason")

  supplier      Supplier                 @relation(fields: [supplierId], references: [id])
  project       Project?                 @relation(fields: [projectNumber], references: [projectNumber])
  createdBy     User                     @relation("PO_CreatedBy", fields: [createdById], references: [id])
  approvedBy    User?                    @relation("PO_ApprovedBy", fields: [approvedById], references: [id])
  shippedBy     User?                    @relation("PO_ShippedBy", fields: [shippedById], references: [id])
  deliveredBy   User?                    @relation("PO_DeliveredBy", fields: [deliveredById], references: [id])
  cancelledBy   User?                    @relation("PO_CancelledBy", fields: [cancelledById], references: [id])
  closedBy      User?                    @relation("PO_ClosedBy", fields: [closedById], references: [id])
  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]
  // The request for quotation this order was awarded from, if any.
  rfq           Rfq?
  signatures    PurchaseOrderSignature[]

  @@index([status])
  @@index([supplierId])
  @@index([projectNumber])
  @@map("purchase_orders")
}

// One signature on an order. An order is approved when every step it needs is
// signed; changing its money clears them, and the audit log keeps the history.
model PurchaseOrderSignature {
  id              String       @id @default(uuid())
  purchaseOrderId String       @map("purchase_order_id")
  step            ApprovalStep
  signedById      String       @map("signed_by_id")
  signedAt        DateTime     @default(now()) @map("signed_at")
  // Signed by the CEO or Workshop Manager in place of the step's usual signer.
  standIn         Boolean      @default(false) @map("stand_in")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  signedBy      User          @relation("PO_SignedBy", fields: [signedById], references: [id])

  @@unique([purchaseOrderId, step])
  @@index([signedById])
  @@map("purchase_order_signatures")
}

model PurchaseOrderLine {
  id              String    @id @default(uuid())
  purchaseOrderId String    @map("purchase_order_id")
  materialId      String    @map("material_id")
  orderedQty      Decimal   @map("ordered_qty") @db.Decimal(18, 4)
  receivedQty     Decimal   @default(0) @map("received_qty") @db.Decimal(18, 4)
  // Excluding VAT, in the order's currency. Null on lines raised before prices were kept.
  // The supplier's list price: the line's discount comes off it.
  unitPrice       Decimal?  @map("unit_price") @db.Decimal(18, 4)
  // Percent off the unit price, as the supplier gives it; 0 for none. What is
  // paid, and its VAT and approval, are on the discounted price.
  discountPercent Decimal   @default(0) @map("discount_percent") @db.Decimal(5, 2)
  // When this line is due; the order's expected date when not set.
  deliveryDate    DateTime? @map("delivery_date") @db.Date

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  material      Material      @relation(fields: [materialId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

// ── Requests for quotation (RFQ roadmap) ─────────────────────────────────
// As the RFQ sheet of the AFRI-02A-xxxx-02-01 Manhours and Material workbook:
// the lines to price go to several suppliers, each supplier's quote is kept
// against the RFQ, and the one awarded becomes a draft purchase order.
//
// DRAFT → SENT → AWARDED, or CANCELLED from DRAFT or SENT.
enum RfqStatus {
  DRAFT
  SENT
  AWARDED
  CANCELLED
}

model Rfq {
  id                 String    @id @default(uuid())
  // For a project, the workbook's document number, AFRI-02A-1325-02-01 for
  // AFRI-1325; without one, RFQ-0001 onwards.
  number             String    @unique
  status             RfqStatus @default(DRAFT)
  projectNumber      String?   @map("project_number")
  description        String?
  // Remarks, printed under the lines.
  notes              String?
  penaltiesApply     Boolean   @default(false) @map("penalties_apply")
  issuedAt           DateTime? @map("issued_at") @db.Date
  closingDate        DateTime? @map("closing_date") @db.Date
  createdById        String    @map("created_by_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  sentAt             DateTime? @map("sent_at")
  sentById           String?   @map("sent_by_id")
  awardedAt          DateTime? @map("awarded_at")
  awardedById        String?   @map("awarded_by_id")
  // The draft order the award created; its supplier is the one awarded.
  purchaseOrderId    String?   @unique @map("purchase_order_id")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelledById      String?   @map("cancelled_by_id")
  cancellationReason String?   @map("cancellation_reason")
  // The supplier whose recorded quote Procurement recommends Sales costs the job
  // from. Not an award: no order is raised until the job is won.
  recommendedSupplierId String?   @map("recommended_supplier_id")
  recommendedAt         DateTime? @map("recommended_at")
  recommendedById       String?   @map("recommended_by_id")

  project       Project?       @relation(fields: [projectNumber], references: [projectNumber])
  recommendedSupplier Supplier? @relation("RFQ_RecommendedSupplier", fields: [recommendedSupplierId], references: [id])
  recommendedBy       User?     @relation("RFQ_RecommendedBy", fields: [recommendedById], references: [id])
  salesMaterials      SalesRfqMaterial[]
  createdBy     User           @relation("RFQ_CreatedBy", fields: [createdById], references: [id])
  sentBy        User?          @relation("RFQ_SentBy", fields: [sentById], references: [id])
  awardedBy     User?          @relation("RFQ_AwardedBy", fields: [awardedById], references: [id])
  cancelledBy   User?          @relation("RFQ_CancelledBy", fields: [cancelledById], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  lines         RfqLine[]
  suppliers     RfqSupplier[]

  @@index([status])
  @@index([projectNumber])
  @@map("rfqs")
}

model RfqLine {
  id             String  @id @default(uuid())
  rfqId          String  @map("rfq_id")
  // The sheet's ITEM column: 1, 2, 3, … in the order the lines were entered.
  lineNo         Int     @map("line_no")
  materialId     String  @map("material_id")
  quantity       Decimal @db.Decimal(18, 4)

  rfq          Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  material     Material        @relation(fields: [materialId], references: [id])
  prices       RfqQuotePrice[]

  @@unique([rfqId, lineNo])
  @@index([materialId])
  @@map("rfq_lines")
}

// A supplier asked to quote, and their quote once it is recorded.
model RfqSupplier {
  id             String    @id @default(uuid())
  rfqId          String    @map("rfq_id")
  supplierId     String    @map("supplier_id")
  quoteReference String?   @map("quote_reference")
  // When the quote came in; null until it is recorded.
  quotedAt       DateTime? @map("quoted_at") @db.Date
  validUntil     DateTime? @map("valid_until") @db.Date
  leadTime       String?   @map("lead_time")
  notes          String?
  // The currency the quote was given in: the supplier's when it was recorded,
  // so an award never prices an order in a currency it wasn't quoted in.
  currency       String?
  declined       Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at")

  rfq       Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier  Supplier        @relation(fields: [supplierId], references: [id])
  prices    RfqQuotePrice[]
  quoteFile RfqQuoteFile?

  @@unique([rfqId, supplierId])
  @@index([supplierId])
  @@map("rfq_suppliers")
}

// The supplier's own quotation, as they sent it back (a PDF, as the RFQ sheet
// asks). One per supplier asked; a new one replaces it. Kept in the database so
// it is backed up with the quote it supports.
model RfqQuoteFile {
  rfqSupplierId String   @id @map("rfq_supplier_id")
  fileName      String   @map("file_name")
  size          Int
  data          Bytes
  uploadedAt    DateTime @default(now()) @map("uploaded_at")
  uploadedById  String   @map("uploaded_by_id")

  rfqSupplier RfqSupplier @relation(fields: [rfqSupplierId], references: [id], onDelete: Cascade)
  uploadedBy  User        @relation("RFQ_QuoteFileUploadedBy", fields: [uploadedById], references: [id])

  @@map("rfq_quote_files")
}

// ── Sales requests for quotation ─────────────────────────────────────────
// How the Sales team prices one piece of equipment for the client, the
// "Costing: Sales Rep." step of the RFQ Process Flow: the production labour, at
// each role's selling rate, plus the material, which is one supplier's quote on
// each of the project's Procurement RFQs Sales picks (Procurement recommends
// one), with the job's markup on the whole. Delivery is priced on its own. Nothing goes to a
// supplier. The Director approves the price; it then has a quotation reference
// and its quotation goes to the client. Kept apart from Procurement's RFQs, as
// buyers and the store must not see the price or the margin.
//
// DRAFT → PENDING_APPROVAL → APPROVED; the Director can send a submitted one
// back to DRAFT with a reason; CANCELLED from any of them.
enum SalesRfqStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  CANCELLED
}

model SalesRfq {
  id                 String         @id @default(uuid())
  // AFRI-02A-1325-02-01 for AFRI-1325, in one sequence per project with
  // Procurement's RFQs.
  number             String         @unique
  // The quotation's "Our Reference", AFRI-02A-1325-04-1: given when it is approved.
  quoteReference     String?        @unique @map("quote_reference")
  status             SalesRfqStatus @default(DRAFT)
  projectNumber      String         @map("project_number")
  // What is being priced, the quotation's one equipment line: "Main Piston Pump".
  equipment          String?
  description        String?
  // Remarks for Sales and the Director; not printed on the quotation.
  notes              String?
  penaltiesApply     Boolean        @default(false) @map("penalties_apply")
  // The job's markup on labour and material together, as a percentage: 40 for the
  // sheet's "× 1.4". Needed to submit, not to save a draft.
  markupPercent      Decimal?       @map("markup_percent") @db.Decimal(7, 2)
  // Rand excl. VAT, without markup: the quotation's Delivery line.
  deliveryPrice      Decimal        @default(0) @map("delivery_price") @db.Decimal(18, 2)
  // VAT as it was when submitted, so the Director approves the figures Sales saw.
  vatRate            Decimal?       @map("vat_rate") @db.Decimal(5, 2)
  // Who the quotation is to, as Sales types it.
  clientName         String?        @map("client_name")
  clientAddress      String?        @map("client_address")
  // "Dear Bongi".
  contactName        String?        @map("contact_name")
  // "Your Reference".
  clientReference    String?        @map("client_reference")
  // The quotation's Conditions.
  paymentTerms       String?        @map("payment_terms")
  validity           String?
  deliveryDuration   String?        @map("delivery_duration")
  deliveryTerms      String?        @map("delivery_terms")
  // Printed under the Sales person's name, who signs the quotation.
  signerPhone        String?        @map("signer_phone")
  signerEmail        String?        @map("signer_email")
  // The day it was approved: the quotation's date.
  issuedAt           DateTime?      @map("issued_at") @db.Date
  // When the client wants the price by.
  closingDate        DateTime?      @map("closing_date") @db.Date
  createdById        String         @map("created_by_id")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  submittedAt        DateTime?      @map("submitted_at")
  submittedById      String?        @map("submitted_by_id")
  approvedAt         DateTime?      @map("approved_at")
  approvedById       String?        @map("approved_by_id")
  // The last time the Director sent it back, and why; kept until it is submitted again.
  returnedAt         DateTime?      @map("returned_at")
  returnedById       String?        @map("returned_by_id")
  returnReason       String?        @map("return_reason")
  cancelledAt        DateTime?      @map("cancelled_at")
  cancelledById      String?        @map("cancelled_by_id")
  cancellationReason String?        @map("cancellation_reason")

  project        Project                 @relation(fields: [projectNumber], references: [projectNumber])
  createdBy      User                    @relation("SalesRfq_CreatedBy", fields: [createdById], references: [id])
  submittedBy    User?                   @relation("SalesRfq_SubmittedBy", fields: [submittedById], references: [id])
  approvedBy     User?                   @relation("SalesRfq_ApprovedBy", fields: [approvedById], references: [id])
  returnedBy     User?                   @relation("SalesRfq_ReturnedBy", fields: [returnedById], references: [id])
  cancelledBy    User?                   @relation("SalesRfq_CancelledBy", fields: [cancelledById], references: [id])
  labour         SalesRfqLabourLine[]
  materials      SalesRfqMaterial[]

  @@index([status])
  @@index([projectNumber])
  @@map("sales_rfqs")
}

// One role's hours on the job, priced at its selling rate when the line was saved.
model SalesRfqLabourLine {
  id           String  @id @default(uuid())
  rfqId        String  @map("sales_rfq_id")
  lineNo       Int     @map("line_no")
  labourRateId String  @map("labour_rate_id")
  // The role as it was named when the line was saved.
  role         String
  hours        Decimal @db.Decimal(10, 2)
  // Rand per hour, excl. VAT, before markup.
  hourlyRate   Decimal @map("hourly_rate") @db.Decimal(18, 2)

  rfq        SalesRfq   @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  labourRate LabourRate @relation(fields: [labourRateId], references: [id])

  @@unique([rfqId, lineNo])
  @@index([labourRateId])
  @@map("sales_rfq_labour_lines")
}

// One Procurement RFQ's quote counted as material: one supplier's whole quote
// per RFQ.
model SalesRfqMaterial {
  salesRfqId String   @map("sales_rfq_id")
  rfqId      String   @map("rfq_id")
  supplierId String   @map("supplier_id")
  // The quote's total excl. VAT in its own currency, and in rand at the day's
  // exchange rate: refreshed on save, fixed on submission, so what was approved
  // stays put if the quote is corrected afterwards.
  quoteTotal Decimal  @map("quote_total") @db.Decimal(18, 2)
  currency   String
  amount     Decimal  @db.Decimal(18, 2)
  addedAt    DateTime @default(now()) @map("added_at")

  salesRfq SalesRfq @relation(fields: [salesRfqId], references: [id], onDelete: Cascade)
  rfq      Rfq      @relation(fields: [rfqId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@id([salesRfqId, rfqId])
  @@index([rfqId])
  @@map("sales_rfq_materials")
}

// The hourly selling rate for each role, as the sheet's Manpower Rate list (A–B),
// that Sales prices labour at. Kept up to date by the Workshop Manager. A role
// that is no longer used is made inactive rather than deleted, as lines name it.
model LabourRate {
  id         String   @id @default(uuid())
  role       String   @unique
  // Rand per hour, excl. VAT.
  hourlyRate Decimal  @map("hourly_rate") @db.Decimal(18, 2)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  lines SalesRfqLabourLine[]

  @@map("labour_rates")
}

// One supplier's unit price for one line, excluding VAT, in the supplier's currency.
model RfqQuotePrice {
  rfqSupplierId String  @map("rfq_supplier_id")
  rfqLineId     String  @map("rfq_line_id")
  unitPrice     Decimal @map("unit_price") @db.Decimal(18, 4)

  rfqSupplier RfqSupplier @relation(fields: [rfqSupplierId], references: [id], onDelete: Cascade)
  rfqLine     RfqLine     @relation(fields: [rfqLineId], references: [id], onDelete: Cascade)

  @@id([rfqSupplierId, rfqLineId])
  @@index([rfqLineId])
  @@map("rfq_quote_prices")
}

enum GoodsReceiptStatus {
  DRAFT
  SUBMITTED
  POSTED
}

model GoodsReceipt {
  id              String             @id @default(uuid())
  number          String             @unique
  purchaseOrderId String?            @map("purchase_order_id")
  supplierId      String             @map("supplier_id")
  deliveryRef     String?            @map("delivery_ref")
  status          GoodsReceiptStatus @default(DRAFT)
  receivedById    String             @map("received_by_id")
  // The date on the delivery note, which may be earlier than it was booked.
  receivedAt      DateTime           @default(now()) @map("received_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  // When its stock went into the ledger (status POSTED), which is when it
  // counts on the reports: a back-dated delivery note never changes a month
  // already reported. Null until posted.
  postedAt        DateTime?          @map("posted_at")

  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier           @relation(fields: [supplierId], references: [id])
  receivedBy    User               @relation("GR_ReceivedBy", fields: [receivedById], references: [id])
  lines         GoodsReceiptLine[]

  @@index([status])
  @@index([purchaseOrderId])
  @@index([status, postedAt])
  @@map("goods_receipts")
}

// One item on a stock count: what the system had and what was counted, matched
// or not. The count itself is the STOCK_COUNT audit entry with this count id;
// its differences were posted as COUNT_VARIANCE adjustments.
model StockCountLine {
  id               String  @id @default(uuid())
  countId          String  @map("count_id")
  materialId       String  @map("material_id")
  expectedQuantity Decimal @map("expected_quantity") @db.Decimal(18, 4)
  countedQuantity  Decimal @map("counted_quantity") @db.Decimal(18, 4)
  // Why it differs, as the counter wrote it; also added to its adjustment's note.
  note             String?

  material Material @relation(fields: [materialId], references: [id])

  @@index([countId])
  @@map("stock_count_lines")
}

model GoodsReceiptLine {
  id                  String  @id @default(uuid())
  goodsReceiptId      String  @map("goods_receipt_id")
  materialId          String  @map("material_id")
  locationId          String  @map("location_id")
  quantity            Decimal @db.Decimal(18, 4)
  purchaseOrderLineId String? @map("purchase_order_line_id")

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  material     Material     @relation(fields: [materialId], references: [id])
  location     Location     @relation(fields: [locationId], references: [id])

  @@index([goodsReceiptId])
  @@map("goods_receipt_lines")
}

// ─── Inventory (the ledger) ───────────────────────────────────────────────

enum InventoryTransactionType {
  RECEIPT
  ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  // Unused stock coming back from an issue. referenceType 'Return' and
  // referenceId = the issue's id; recipient and project are copied from it.
  RETURN
  // A tool lent to a recipient (negative): it leaves its location but stays
  // owned. Lines lent together share an issueId (the loan slip).
  LOAN
  // A lent tool coming back (positive). referenceType 'ToolLoan' and
  // referenceId = the loan's id; recipient and project are copied from it.
  // reasonCode DAMAGE when it came back damaged; LOSS when it was lost, with
  // an ADJUSTMENT (LOSS) writing it off at the same time.
  LOAN_RETURN
}

// The reason sets the direction: DAMAGE, LOSS and SCRAP only remove stock and
// FOUND only adds it; OTHER may do either; COUNT_VARIANCE comes from a count.
enum AdjustmentReasonCode {
  COUNT_VARIANCE
  DAMAGE
  LOSS
  SCRAP
  OTHER
  FOUND
}

model InventoryTransaction {
  id                    String                   @id @default(uuid())
  materialId            String                   @map("material_id")
  locationId            String                   @map("location_id")
  type                  InventoryTransactionType
  // Signed: RECEIPT/TRANSFER_IN are positive; ISSUE/TRANSFER_OUT negative;
  // ADJUSTMENT may be either. Stored as Decimal so transactions are atomic and exact.
  quantity              Decimal                  @db.Decimal(18, 4)
  // Polymorphic reference to the document that caused the transaction.
  referenceType         String?                  @map("reference_type")
  referenceId           String?                  @map("reference_id")
  // Who received the stock (issues; copied onto their reversals).
  recipientId           String?                  @map("recipient_id")
  // Issues and tool loans: shared by every line one issue or check-out posted
  // (the slip). Earlier issue lines carry their own id; reversals and other
  // types carry none.
  issueId               String?                  @map("issue_id")
  // Tool loans (LOAN): the day the tool is due back, agreed at check-out. Set
  // when the loan is posted and never changed; a different date is a
  // ToolLoanExtension. Null on loans from before due dates, which fall due
  // inventory.toolOverdueDays after they went out.
  dueOn                 DateTime?                @map("due_on") @db.Date
  // Tool loans (LOAN): why tools were lent to someone who already had an
  // overdue one. Set when the loan is posted and never changed.
  overdueOverrideReason String?                  @map("overdue_override_reason")
  // Adjustment reason (mandatory for type=ADJUSTMENT).
  reasonCode            AdjustmentReasonCode?    @map("reason_code")
  reasonNote            String?                  @map("reason_note")
  // Project linkage (FR-REP-004): who the stock was used for. A Stores item
  // issued to a project carries it, though it comes out of Stores stock.
  projectNumber         String?                  @map("project_number")
  // Whose stock it is: the project it is held for, or null for Stores stock,
  // the store's own. Not the same as projectNumber above. A movement adds to
  // or takes from the balance held for this project only (Project Material
  // Through the Store Roadmap, Phase 1).
  heldForProject        String?                  @map("held_for_project")
  // Audit fields
  actorId               String                   @map("actor_id")
  postedAt              DateTime                 @default(now()) @map("posted_at")
  // For transfers: the linked partner transaction id so both legs are tied.
  pairedWithId          String?                  @unique @map("paired_with_id")
  // For reversals: the transaction this one cancels. A reversal keeps the
  // original's type with the opposite sign, so signed totals net to zero.
  // Unique, so a transaction can be reversed at most once. The ledger has no
  // update path; mistakes are corrected only by reversing.
  reversesId            String?                  @unique @map("reverses_id")

  material           Material              @relation(fields: [materialId], references: [id])
  location           Location              @relation(fields: [locationId], references: [id])
  actor              User                  @relation(fields: [actorId], references: [id])
  project            Project?              @relation("UsedFor", fields: [projectNumber], references: [projectNumber])
  heldFor            Project?              @relation("HeldFor", fields: [heldForProject], references: [projectNumber], onDelete: Restrict, onUpdate: Restrict)
  recipient          Recipient?            @relation(fields: [recipientId], references: [id])
  pairedWith         InventoryTransaction? @relation("TransferPair", fields: [pairedWithId], references: [id])
  pairedBy           InventoryTransaction? @relation("TransferPair")
  reverses           InventoryTransaction? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy         InventoryTransaction? @relation("Reversal")
  loanExtensions     ToolLoanExtension[]
  // Issues: used up or broken against it. Returns: the marks booked in the same counter visit.
  consumableOutcomes ConsumableOutcome[]   @relation("OutcomeIssue")
  bookedOutcomes     ConsumableOutcome[]   @relation("OutcomeReturn")
  // An adjustment posted on approval: the request it came from.
  adjustmentRequest  AdjustmentRequest?

  @@index([materialId, locationId, postedAt])
  @@index([referenceType, referenceId])
  @@index([postedAt])
  @@index([type])
  @@index([recipientId])
  @@index([issueId])
  @@index([materialId, locationId, heldForProject])
  @@map("inventory_transactions")
}

enum AdjustmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// An adjustment worth more than inventory.writeOffApprovalAbove, waiting for
// someone other than whoever asked for it (segregation of duties). Nothing
// moves until it is approved: approving posts the ADJUSTMENT (transactionId),
// rejecting posts nothing. value is quantity x the item's unit cost when asked,
// null when the item has no cost, which also needs approval.
model AdjustmentRequest {
  id             String                  @id @default(uuid())
  materialId     String                  @map("material_id")
  locationId     String                  @map("location_id")
  heldForProject String?                 @map("held_for_project")
  // Signed, as the ADJUSTMENT it becomes.
  quantity       Decimal                 @db.Decimal(18, 4)
  reasonCode     AdjustmentReasonCode    @map("reason_code")
  reasonNote     String?                 @map("reason_note")
  recipientId    String?                 @map("recipient_id")
  // Who the stock was used for, and what the adjustment comes from, as on the
  // ADJUSTMENT it becomes: a stock count (StockCount, its count id) or a tool
  // lost on loan (ToolLoan, the loan; its return is posted on approval too).
  projectNumber  String?                 @map("project_number")
  referenceType  String?                 @map("reference_type")
  referenceId    String?                 @map("reference_id")
  value          Decimal?                @db.Decimal(18, 2)
  status         AdjustmentRequestStatus @default(PENDING)
  requestedById  String                  @map("requested_by_id")
  requestedAt    DateTime                @default(now()) @map("requested_at")
  decidedById    String?                 @map("decided_by_id")
  decidedAt      DateTime?               @map("decided_at")
  decisionNote   String?                 @map("decision_note")
  transactionId  String?                 @unique @map("transaction_id")

  material    Material              @relation(fields: [materialId], references: [id])
  location    Location              @relation(fields: [locationId], references: [id])
  recipient   Recipient?            @relation(fields: [recipientId], references: [id])
  requestedBy User                  @relation("AdjustmentRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?                 @relation("AdjustmentDecidedBy", fields: [decidedById], references: [id])
  transaction InventoryTransaction? @relation(fields: [transactionId], references: [id])

  @@index([status, requestedAt])
  @@index([referenceType, referenceId])
  @@map("adjustment_requests")
}

// A tool loan's due date changed, later or earlier, and why. Only ever added
// to, never changed: a loan is due on the date of its most recent change, or
// else on the one agreed at check-out. Listed on Movements beside the loan's
// check-out and check-in.
model ToolLoanExtension {
  id        String   @id @default(uuid())
  loanId    String   @map("loan_id")
  dueOn     DateTime @map("due_on") @db.Date
  reason    String
  actorId   String   @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")

  loan  InventoryTransaction @relation(fields: [loanId], references: [id])
  actor User                 @relation(fields: [actorId], references: [id])

  @@index([loanId])
  @@index([createdAt])
  @@map("tool_loan_extensions")
}

// Why an item was deactivated or reactivated (ADR-033). OTHER needs a note.
enum MaterialStatusReason {
  OBSOLETE
  SUPERSEDED
  SUPPLIER_DISCONTINUED
  CREATED_IN_ERROR
  BACK_IN_USE
  STOCK_CAME_BACK
  DEACTIVATED_IN_ERROR
  OTHER
}

// An item deactivated or reactivated (ADR-033). It moves no stock and belongs
// to no location, so it is not a ledger line; Movements lists it with no
// quantity, as it does a due date change. Only ever added to: a mistake is put
// right by changing the status back. reasonCode is null only on changes from
// before this record, copied from the audit log.
model MaterialStatusChange {
  id         String                @id @default(uuid())
  materialId String                @map("material_id")
  // The status it changed to.
  active     Boolean
  reasonCode MaterialStatusReason? @map("reason_code")
  note       String?
  actorId    String                @map("actor_id")
  createdAt  DateTime              @default(now()) @map("created_at")

  material Material @relation(fields: [materialId], references: [id])
  actor    User     @relation(fields: [actorId], references: [id])

  @@index([materialId, createdAt])
  @@index([createdAt])
  @@map("material_status_changes")
}

enum ConsumableOutcomeKind {
  USED_UP
  BROKEN
}

// What became of a tracked consumable (Material.trackUse) after it was issued:
// used up or broken, recorded against the issue line when the stub or the
// broken piece comes back. No stock moves: it left the shelf at the issue.
// Only ever added to: a mistake is withdrawn by a row that names it
// (withdrawsId, with the reason in note), and the pair then counts for
// nothing, as a ledger reversal does.
model ConsumableOutcome {
  id                  String                @id @default(uuid())
  issueTransactionId  String                @map("issue_transaction_id")
  outcome             ConsumableOutcomeKind
  quantity            Decimal               @db.Decimal(18, 4)
  note                String?
  // Unique, so an outcome is withdrawn at most once.
  withdrawsId         String?               @unique @map("withdraws_id")
  // The RETURN booked in the same counter visit, when some also went back on
  // the shelf; Movements shows the mark on that row. Without one, the mark is
  // its own row (nothing went back on the shelf).
  returnTransactionId String?               @map("return_transaction_id")
  actorId             String                @map("actor_id")
  createdAt           DateTime              @default(now()) @map("created_at")

  issue       InventoryTransaction  @relation("OutcomeIssue", fields: [issueTransactionId], references: [id])
  return      InventoryTransaction? @relation("OutcomeReturn", fields: [returnTransactionId], references: [id])
  actor       User                  @relation(fields: [actorId], references: [id])
  withdraws   ConsumableOutcome?    @relation("OutcomeWithdrawal", fields: [withdrawsId], references: [id])
  withdrawnBy ConsumableOutcome?    @relation("OutcomeWithdrawal")

  @@index([issueTransactionId])
  @@index([returnTransactionId])
  @@index([createdAt])
  @@map("consumable_outcomes")
}

// ADR-002: derived/materialized view. Application code never writes to this
// table; it's recomputed by the recomputeBalances job / refresh trigger.
model InventoryBalance {
  materialId     String   @map("material_id")
  locationId     String   @map("location_id")
  // The project the stock is held for, or '' for Stores stock. Not null, so
  // it can be part of the key: one Stores balance per item and location, and
  // one per project. No foreign key, as the row is rebuilt from the ledger;
  // read and write it through shared/inventory/balances.ts.
  heldForProject String   @default("") @map("held_for_project")
  quantity       Decimal  @db.Decimal(18, 4)
  updatedAt      DateTime @updatedAt @map("updated_at")

  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([materialId, locationId, heldForProject])
  @@index([locationId])
  @@map("inventory_balances")
}

// ─── System Settings (typed key/value configuration) ────────────────────

enum SettingType {
  string
  number
  boolean
  enum
}

enum SettingCategory {
  general
  inventory
  purchase_orders
  notifications
  users
  appearance
  security
  system
  data
  projects
}

model Setting {
  key         String          @id
  value       Json
  type        SettingType
  category    SettingCategory
  description String
  isEditable  Boolean         @default(true) @map("is_editable")
  // Allowed enum values (only when type = enum). Null for other types.
  enumOptions Json?           @map("enum_options")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  updatedById String?         @map("updated_by_id")

  updatedBy User? @relation("SettingUpdatedBy", fields: [updatedById], references: [id])

  @@index([category])
  @@map("settings")
}

// ─── Audit (append-only) ──────────────────────────────────────────────────

model AuditLogEntry {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log_entries")
}

// ─── Idempotency (retry-safe mutations) ───────────────────────────────────
//
// ADR/API principle 3: a mutating endpoint is idempotent-safe for retries, so a
// network retry never double-posts a transaction (TD-019). A client sends an
// `Idempotency-Key` header; the first request runs, and its response is stored
// here. A repeat with the same key and the same request body replays the stored
// response without running the operation again. A repeat with the same key but
// a *different* body is a client mistake and is refused with a 409, rather than
// silently replaying an unrelated answer.
//
// Scope is (actor, endpoint, key): a key is meaningful only to the user who
// minted it, so one user cannot probe or collide with another's operations.
model IdempotencyKey {
  id          String   @id @default(uuid())
  // The user the key belongs to. Cascades: a deleted user's keys are worthless.
  actorId     String   @map("actor_id")
  // The route template the key was used on, e.g. "POST /inventory-issues".
  endpoint    String
  key         String
  // Hash of the request (concrete path + body), so a reused key with a
  // different payload or record is caught rather than replayed.
  requestHash String   @map("request_hash")
  // The HTTP status and body of the original response, replayed verbatim.
  statusCode  Int      @map("status_code")
  response    Json
  createdAt   DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  // The lookup is always by this triple; the unique index makes the insert the
  // concurrency control — two simultaneous retries race on it, and the loser
  // re-reads and replays instead of running the operation twice.
  @@unique([actorId, endpoint, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// ─── Backups (ADR-037) ────────────────────────────────────────────────────
// One row per backup or restore test, written by the backup service
// (apps/backend/backup), so Admins see on the Dashboard when backups are late,
// failing or never left the server. The application never writes it.
model BackupRun {
  id         String   @id @default(uuid())
  // BACKUP or RESTORE_TEST (checked in the migration).
  kind       String
  // OK or FAILED (checked in the migration).
  status     String
  startedAt  DateTime @map("started_at")
  finishedAt DateTime @default(now()) @map("finished_at")
  fileName   String?  @map("file_name")
  sizeBytes  BigInt?  @map("size_bytes")
  // Copied to the off-site store as well as the server's backup disk.
  offsite    Boolean  @default(false)
  detail     String?
  // Row counts at backup time, or the restored copy's, to compare.
  counts     Json?

  @@index([kind, finishedAt])
  @@map("backup_runs")
}

// A change of an item's unit cost, with why (system audit C3, ADR-039). Unit
// cost values stock and decides whether a write-off needs someone else's
// approval, so each change is kept and shown on the item.
model MaterialCostChange {
  id         String   @id @default(uuid())
  materialId String   @map("material_id")
  before     Decimal? @db.Decimal(18, 4)
  after      Decimal? @db.Decimal(18, 4)
  reason     String
  actorId    String   @map("actor_id")
  createdAt  DateTime @default(now()) @map("created_at")

  material Material @relation(fields: [materialId], references: [id])
  actor    User     @relation(fields: [actorId], references: [id])

  @@index([materialId, createdAt])
  @@map("material_cost_changes")
}

// Sign-ins and failed sign-ins, kept 12 months (system audit F3, ADR-039), so
// an Admin can see who signed in when, and repeated wrong passwords.
model SignInEvent {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  // As typed, lower case: kept for a failed sign-in with no such account too.
  email     String
  // SIGN_IN, FAILED, THROTTLED or SIGN_OUT (checked in the migration).
  outcome   String
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("sign_in_events")
}
