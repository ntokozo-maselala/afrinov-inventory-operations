{
  "name": "@afrinov/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "prebuild": "npm run db:generate",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src integration scripts --ext .ts",
    "pretypecheck": "npm run db:generate",
    "typecheck": "tsc -p tsconfig.tools.json",
    "pretest": "npm run db:generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:integration": "npm run db:generate",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:test:migrate": "tsx scripts/test-database.ts migrate",
    "db:test:seed": "tsx scripts/test-database.ts seed",
    "db:seed": "tsx src/db/seed.ts",
    "db:rotate-admin": "tsx --env-file-if-exists=.env scripts/rotate-admin-password.ts",
    "import:workbook": "tsx --env-file-if-exists=.env scripts/import-workbook.ts",
    "import:suppliers": "tsx --env-file-if-exists=.env scripts/import-suppliers.ts",
    "diag:login": "tsx --env-file=.env scripts/diag-login.ts",
    "diag:admin": "tsx --env-file=.env scripts/diagnostic.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.0.0",
    "pdfkit": "^0.20.2",
    "prisma": "^5.18.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pdfkit": "^0.17.6",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^8.57.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^5.0.0"
  }
}
