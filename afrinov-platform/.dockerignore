# Build context for the backend image. The Dockerfile is built from the
# workspace root and only needs manifests, lockfile, backend sources, and schema.
# Excluding host artifacts keeps OS-specific files out of the image and local
# credentials out of its layers.
**/node_modules
**/dist
**/.git
**/.env
**/.env.*
!**/.env.example
!**/.env.test.example
**/coverage
**/*.log
**/.vscode
**/.idea
**/playwright-report
**/test-results
docs
**/audit-out.json
**/*-out.txt
